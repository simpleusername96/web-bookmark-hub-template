{
  "manifest_version": 3,
  "name": "Web Bookmark Hub",
  "version": "0.2.2",
  "minimum_chrome_version": "102",
  "description": "Save current tabs and explicitly selected images to a private local URL Registry.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*"]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Web Bookmark Hub",
    "default_popup": "popup.html"
  },
  "commands": {
    "save-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Save current tab to Web Bookmark Hub"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
